# ── AIKAGAN-web_revised environment ─────────────────────────────────────────
# This is an independent, self-sufficient build. Every provider is optional.
# With no provider keys set, the funnel runs in DEMO mode (sandbox checkout),
# so the whole loop can be exercised and deployed free with zero credentials.

# Payment rail adapter: "demo" | "stripe" | "gumroad" | "paddle" | "shopier"
PAYMENT_RAIL=demo

# Stripe (server-side secret key)
STRIPE_SECRET_KEY=
STRIPE_PRICE_PREFIX=

# Gumroad
GUMROAD_TOKEN=
GUMROAD_PRODUCT_URL=

# Paddle
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=

# Persistence: "memory" | "upstash" (leave blank for memory)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Attribution
NEXT_PUBLIC_APP_ORIGIN=https://aikagan-web-revised.vercel.app
